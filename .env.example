DATABASE_URL="postgresql://siteyonetim:localdev@localhost:5432/siteyonetim?schema=public"

# Bulut ortamında sağlayıcının PostgreSQL URL'sini secret olarak tanımlayın.
# Parola kurtarma için HTTPS uygulama adresi ve TLS kullanan SMTP gereklidir.
APP_URL="http://localhost:3000"
# SMTP_URL ve MAIL_FROM gerçek sağlayıcı bilgileriyle doldurulmalı; Git'e eklenmemeli.
# SMTP_URL="smtps://USER:PASSWORD@HOST:465"
# MAIL_FROM="SiteYonetim <SENDER_ADDRESS>"
# Test komutları yalnızca localhost/127.0.0.1 siteyonetim_test veritabanını kabul eder.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:PORT/siteyonetim_test"

# S01-C: Gerçek ortamda APP_URL yalnız HTTPS origin olmalı.
# SMTP_URL: smtps:// veya zorunlu STARTTLS ile smtp://. Sertifika doğrulaması kapatılmaz.
# MIGRATION_DATABASE_URL: CI secret adı önerisi; Prisma bunu otomatik okumaz.
# Migration komutunun DATABASE_URL değeri ayrı DDL rolü/doğrudan bağlantıyla enjekte edilir.
# Bakım: ayrı, sınırlı DB rolüyle npm run security:cleanup -- --apply

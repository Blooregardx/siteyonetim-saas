generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  RESIDENT
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String
  createdAt   DateTime     @default(now())
  memberships Membership[]
}

model Site {
  id            String         @id @default(cuid())
  name          String
  address       String?
  createdAt     DateTime       @default(now())
  memberships   Membership[]
  blocks        Block[]
  units         Unit[]
  charges       Charge[]
  payments      Payment[]
  announcements Announcement[]
}

model Membership {
  siteId String
  userId String
  role   Role   @default(RESIDENT)
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([siteId, userId])
  @@index([userId])
}

model Block {
  id     String @id @default(cuid())
  siteId String
  name   String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)
  units  Unit[]

  @@unique([siteId, id])
  @@unique([siteId, name])
}

model Unit {
  id      String   @id @default(cuid())
  siteId  String
  blockId String
  number  String
  site    Site     @relation(fields: [siteId], references: [id], onDelete: Restrict)
  block   Block    @relation(fields: [siteId, blockId], references: [siteId, id], onDelete: Restrict)
  charges Charge[]

  @@unique([siteId, id])
  @@unique([siteId, blockId, number])
}

model Charge {
  id          String    @id @default(cuid())
  siteId      String
  unitId      String
  period      String
  amountKurus Int
  dueDate     DateTime  @db.Date
  createdAt   DateTime  @default(now())
  site        Site      @relation(fields: [siteId], references: [id], onDelete: Restrict)
  unit        Unit      @relation(fields: [siteId, unitId], references: [siteId, id], onDelete: Restrict)
  payments    Payment[]

  @@unique([siteId, id])
  @@unique([siteId, unitId, period])
  @@index([siteId, dueDate])
}

model Payment {
  id             String   @id @default(cuid())
  siteId         String
  chargeId       String
  amountKurus    Int
  paidAt         DateTime @default(now())
  idempotencyKey String
  reference      String?
  site           Site     @relation(fields: [siteId], references: [id], onDelete: Restrict)
  charge         Charge   @relation(fields: [siteId, chargeId], references: [siteId, id], onDelete: Restrict)

  @@unique([siteId, idempotencyKey])
  @@index([siteId, chargeId])
}

model Announcement {
  id        String   @id @default(cuid())
  siteId    String
  title     String
  body      String
  createdAt DateTime @default(now())
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@index([siteId, createdAt])
}

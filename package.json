{
  "name": "siteyonetim-saas",
  "version": "0.1.0-alpha.1",
  "description": "Ücretsiz, özgür ve kendi sunucusunda barındırılabilir site ve apartman yönetimi yazılımı",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test:integration": "tsx --test --test-concurrency=1 tests/*.integration.ts",
    "test:e2e": "playwright test",
    "security:cleanup": "tsx scripts/cleanup.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blooregardx/siteyonetim-saas.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/Blooregardx/siteyonetim-saas/issues"
  },
  "homepage": "https://github.com/Blooregardx/siteyonetim-saas#readme",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "^16.4.3",
    "nodemailer": "^10.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "prisma": "^6.19.3",
    "smtp-server": "^3.21.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "license": "AGPL-3.0-only"
}
